<?xml version="1.0" encoding="UTF-8"?>
<!--
  This file configures the OFBiz Entity Engine for Quarkus + Agroal usage.

  - Transaction & connection settings now come from Quarkus (application.properties).
  - The <transaction-factory> uses AgroalTransactionFactory to integrate
    with Quarkus Narayana.
  - The old <datasource> entries and <inline-jdbc> are removed, as they are no longer used.
-->

<entity-config
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/entity-config.xsd">

    <!-- Resource loader for fieldtype definition files -->
    <resource-loader
            name="fieldfile"
            class="org.sitenetsoft.sunseterp.framework.base.config.FileLoader"
            prepend-env="ofbiz.home"
            prefix="/framework/entity/fieldtype/"/>

    <!-- Transaction factory now points to Quarkus's AgroalTransactionFactory -->
    <transaction-factory
            class="org.sitenetsoft.sunseterp.framework.entity.transaction.AgroalTransactionFactory"/>

    <!-- Debug XA resources typically turned off under Quarkus. -->
    <debug-xa-resources value="false"/>

    <!-- Define your OFBiz delegators and group mappings -->
    <delegator
            name="default"
            entity-model-reader="main"
            entity-group-reader="main"
            entity-eca-reader="main"
            distributed-cache-clear-enabled="false">
        <!--
           Even though we list group-name="org.sitenetsoft.sunseterp.framework" etc.,
           the <datasource> references are no longer used for actual DB connections.
           They are used only so the entity engine can map entities to a "group".
        -->
        <group-map group-name="org.sitenetsoft.sunseterp.framework" datasource-name="localderby"/>
        <group-map group-name="org.sitenetsoft.sunseterp.framework.olap" datasource-name="localderbyolap"/>
        <group-map group-name="org.sitenetsoft.sunseterp.framework.tenant" datasource-name="localderbytenant"/>
    </delegator>

    <!-- Example: a second delegator without entity ECA -->
    <delegator
            name="default-no-eca"
            entity-model-reader="main"
            entity-group-reader="main"
            entity-eca-reader="main"
            entity-eca-enabled="false"
            distributed-cache-clear-enabled="false">
        <group-map group-name="org.sitenetsoft.sunseterp.framework" datasource-name="localderby"/>
        <group-map group-name="org.sitenetsoft.sunseterp.framework.olap" datasource-name="localderbyolap"/>
        <group-map group-name="org.sitenetsoft.sunseterp.framework.tenant" datasource-name="localderbytenant"/>
    </delegator>

    <!-- For test coverage or special scenarios -->
    <delegator
            name="test"
            entity-model-reader="main"
            entity-group-reader="main"
            entity-eca-reader="main">
        <group-map group-name="org.sitenetsoft.sunseterp.framework" datasource-name="localderby"/>
        <group-map group-name="org.sitenetsoft.sunseterp.framework.olap" datasource-name="localderbyolap"/>
        <group-map group-name="org.sitenetsoft.sunseterp.framework.tenant" datasource-name="localderbytenant"/>
    </delegator>

    <!-- Readers for entity model, group, ECA, etc. -->
    <entity-model-reader name="main"/>
    <entity-group-reader name="main"/>
    <entity-eca-reader name="main"/>

    <!-- Data readers for seed, demo, etc. -->
    <entity-data-reader name="tenant"/>
    <entity-data-reader name="seed"/>
    <entity-data-reader name="seed-initial"/>
    <entity-data-reader name="demo"/>
    <entity-data-reader name="ext"/>
    <entity-data-reader name="ext-test"/>
    <entity-data-reader name="ext-demo"/>

    <!-- Field-type definitions (so OFBiz can parse each database fieldtype XML).
         Keep only the ones you actually need.
    -->
    <field-type name="derby" loader="fieldfile" location="fieldtypederby.xml"/>
    <field-type name="mysql" loader="fieldfile" location="fieldtypemysql.xml"/>
    <field-type name="postgres" loader="fieldfile" location="fieldtypepostgres.xml"/>
    <field-type name="oracle" loader="fieldfile" location="fieldtypeoracle.xml"/>
    <field-type name="mssql" loader="fieldfile" location="fieldtypemssql.xml"/>
    <field-type name="firebird" loader="fieldfile" location="fieldtypefirebird.xml"/>
    <field-type name="sybase" loader="fieldfile" location="fieldtypesybase.xml"/>
    <field-type name="sapdb" loader="fieldfile" location="fieldtypesapdb.xml"/>
    <!-- ... plus any others you need ... -->

    <!--
       No <datasource> blocks here, because Quarkus Agroal is now responsible
       for the actual JDBC connections.
    -->

</entity-config>
